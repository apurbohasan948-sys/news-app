# ==============================================================================
# AI NEWSROOM AUTOMATION PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# COPY THIS FILE TO .env AND POPULATE WITH YOUR SECURE API CREDENTIALS.
# NEVER COMMIT REAL KEYS OR SECRETS TO SOURCE CONTROL (.gitignore protects .env).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE LLM PROVIDER CREDENTIALS
# ------------------------------------------------------------------------------
# Google Gemini API (Recommended Default for Synthesis & Fact Checking)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (Fallback / Alternative Provider - GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API (Claude 3.5 Sonnet / Haiku)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq Cloud API (High-speed Llama-3 inference)
GROQ_API_KEY=your_groq_api_key_here

# Mistral AI API (Mistral Large / Pixtral)
MISTRAL_API_KEY=your_mistral_api_key_here

# Local / Self-hosted Ollama or vLLM Endpoint
OLLAMA_BASE_URL=http://localhost:11434/api/generate

# ------------------------------------------------------------------------------
# 2. RESEARCH & VERIFICATION ENGINE
# ------------------------------------------------------------------------------
# Tavily Search API (Deep topic research & raw web source extraction)
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# 3. PUBLISHING CHANNELS & SYNDICATION
# ------------------------------------------------------------------------------
# Google Blogger REST API v3
BLOGGER_BLOG_ID=your_blogger_blog_id_here
BLOGGER_ACCESS_TOKEN=your_oauth2_or_service_access_token_here

# Facebook Graph API (v19.0+)
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# ------------------------------------------------------------------------------
# 4. EDITORIAL AUTOMATION & QUALITY GATE SETTINGS
# ------------------------------------------------------------------------------
# Minimum score (0-100) required to clear Quality Gate for auto-publishing
QUALITY_GATE_THRESHOLD=80

# Maximum auto-rewrite attempts if quality gate fails
MAX_CORRECTION_ATTEMPTS=3

# Automated publishing interval in minutes
PUBLISH_INTERVAL_MINUTES=60

# Operational time window in 24h format (UTC or Local)
ALLOWED_HOURS_START=6
ALLOWED_HOURS_END=23

# Auto Mode (true = autonomous dispatching, false = human editorial review)
AUTO_MODE_ENABLED=false

# ------------------------------------------------------------------------------
# 5. DATABASE & RUNTIME
# ------------------------------------------------------------------------------
# Target environment: development | staging | production
APP_ENV=development
DB_NAME=ai_newsroom.db
